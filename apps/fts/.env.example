# .env.example
# This file serves as a template for all required environment variables.
# Copy this to .env.dev and .env.prod and fill in the values.
# Set the application environment ("dev" or "prod")
# This determines which .env file is loaded (.env.dev or .env.prod)

APP_ENV="dev"

# Set the logging level (e.g., DEBUG, INFO, WARNING, ERROR)

LOG_LEVEL="INFO"

# The one research database: models, datasets, runs, Optuna studies

DATABASE_URL="sqlite+pysqlite:///./dev.db"

# The price cache (bars, corporate actions, FX), shared with portfolio_analyser,
# is NOT set here: fts refuses MARKET_CACHE_URL in this file, because the
# analyser never reads it. Leave it unset for market_cache.db in the workspace
# root, or export it in the shell (a relative SQLite path resolves against the
# workspace root):  export MARKET_CACHE_URL="sqlite:////absolute/path/cache.db"
