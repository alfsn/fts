# .env.example
# This file serves as a template for all required environment variables.
# Copy this to .env.dev and .env.prod and fill in the values.
# Set the application environment ("dev" or "prod")
# This determines which .env file is loaded (.env.dev or .env.prod)

APP_ENV="dev"

# Set the logging level (e.g., DEBUG, INFO, WARNING, ERROR)

LOG_LEVEL="INFO"

# The connection string for the database (e.g., SQLAlchemy)

DATABASE_URL="sqlite+pysqlite:///./dev.db"
BACKTEST_DATABASE_URL="sqlite+pysqlite:///./backtests.db"